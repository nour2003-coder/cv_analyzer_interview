# OpenRouter keys used by CV extraction/ranking.
api_key=your_openrouter_api_key
api_key2=your_second_openrouter_api_key
api_key3=your_third_openrouter_api_key
model_name=meta-llama/llama-3.1-8b-instruct

# Local Chroma vector database path.
CHROMA_PATH=chroma

# RapidAPI resume parser credentials.
API_URL=https://your-rapidapi-endpoint.example.com
API_KEY=your_rapidapi_key
API_HOST=your_rapidapi_host

# MongoDB storage for uploaded/extracted CVs.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cv_database
MONGO_COLLECTION=cvs

# OpenRouter settings used by the interview chatbot API.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_APP_NAME=cv-analyzer-interview
OPENROUTER_APP_URL=http://localhost

# FastAPI chatbot service URL used by the Streamlit pages.
CHATBOT_API_URL=http://localhost:8001
